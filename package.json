{
  "name": "signoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p backend/tsconfig.json && tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "start": "node build/backend/index.js",
    "demo": "npm run build && node build/backend/scripts/demo.js",
    "test": "npm run build && npm run test:backend && npm run test:frontend",
    "verify:config": "npm run build && node build/backend/scripts/check-live.js",
    "photon:test": "node --env-file=.env --env-file-if-exists=.env.photon build/backend/scripts/demo.js --photon",
    "photon:register": "node --env-file=.env build/backend/scripts/register-photon.js",
    "photon:sponsor": "npm run build && node --env-file=.env --env-file=.env.costar --env-file=.env.photon-sponsor build/backend/scripts/demo.js --photon --sponsor",
    "matterport:rooms": "node --env-file-if-exists=.env.costar backend/scripts/matterport-rooms.mjs",
    "test:backend": "node --test build/test/backend/*.test.js",
    "test:frontend": "playwright test --config test/frontend/playwright.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@matterport/sdk": "^1.6.2",
    "hono": "^4.13.18",
    "luxon": "^3.7.2",
    "openai": "^7.57.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
